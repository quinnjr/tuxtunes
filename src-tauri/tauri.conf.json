{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "TuxTunes",
  "version": "0.1.0",
  "identifier": "dev.quinnjr.tuxtunes",
  "build": {
    "devUrl": "http://localhost:4300",
    "beforeDevCommand": "pnpm run start",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist/tuxtunes/browser"
  },
  "app": {
    "windows": [
      {
        "title": "TuxTunes",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/artwork/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
